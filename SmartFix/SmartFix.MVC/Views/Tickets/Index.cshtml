@model IEnumerable<SmartFix.Domain.Entities.MaintenanceTicket>

@{
    ViewData["Title"] = "لوحة التحكم - إدارة تذاكر الصيانة";
}

<div class="container dir-rtl text-right my-4" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🛠️ نظام SmartFix - لوحة متابعة الصيانة</h2>
        <a class="btn btn-primary btn-lg" href="#">+ تذكرة صيانة جديدة</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">قائمة تذاكر الصيانة الحالية</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 text-center">
                <thead class="thead-dark">
                    <tr>
                        <th>رقم التذكرة</th>
                        <th>العميل</th>
                        <th>الجهاز</th>
                        <th>الأولوية</th>
                        <th>الحالة</th>
                        <th>تاريخ الإنشـاء</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in Model)
                    {
                        <tr>
                            <td><strong>@ticket.TicketNumber</strong></td>
                            <td>@(ticket.Customer?.Username ?? "غير معروف")</td>
                            <td>@(ticket.Device?.DeviceName ?? "جهاز غير محدد")</td>
                            <td>
                                <span class="badge @(ticket.Priority == SmartFix.Domain.Enums.Priority.Urgent ? "bg-danger" : ticket.Priority == SmartFix.Domain.Enums.Priority.High ? "bg-warning text-dark" : "bg-info")">
                                    @ticket.Priority
                                </span>
                            </td>
                            <td>
                                <span class="badge @(ticket.Status == SmartFix.Domain.Enums.TicketStatus.Repaired ? "bg-success" : ticket.Status == SmartFix.Domain.Enums.TicketStatus.Pending ? "bg-secondary" : "bg-primary")">
                                    @ticket.Status
                                </span>
                            </td>
                            <td>@ticket.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-info">التفاصيل 👁️</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
